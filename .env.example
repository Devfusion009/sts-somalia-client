# ============================================================================
# STS Somalia — environment configuration
#
# The backend is plug-and-play: every optional integration below lights up
# automatically as soon as its keys are present (see src/lib/integrations.ts).
# With no optional keys set, the app still runs fully — payments fall back to
# manual methods (+ a built-in simulator outside production), and flight
# search shows the quote-request flow.
# ============================================================================

# --- Supabase (required) ----------------------------------------------------
# Local: run `supabase start`, then `supabase status` to see these values.
# Hosted: copy from the Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# Server-only. Bypasses RLS entirely — never expose to the client/browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Direct Postgres connection (migrations, scripts). Local default shown.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Site URL used for auth redirects and payment return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payments (all optional — add keys to enable a gateway) -----------------
# Card payments via Stripe Checkout:
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # endpoint: /api/payments/stripe/webhook

# Somali mobile money via WaafiPay (EVC Plus / ZAAD / Sahal):
# WAAFI_MERCHANT_UID=M0000000
# WAAFI_API_USER_ID=1000000
# WAAFI_API_KEY=API-...
# WAAFI_API_URL=https://api.waafipay.net/asm   # optional override

# eDahab (Dahabshiil) invoices:
# EDAHAB_API_KEY=...
# EDAHAB_AGENT_CODE=...
# EDAHAB_API_URL=https://edahab.net/api/api/issueinvoice   # optional override

# Bank-transfer instructions shown to customers at checkout:
# BANK_TRANSFER_BANK_NAME=Premier Bank
# BANK_TRANSFER_ACCOUNT_NAME=Scout Travel Solution LTD
# BANK_TRANSFER_ACCOUNT_NUMBER=020160002200

# Payment simulator: defaults to ON outside production so the whole checkout
# UX is demoable with zero keys. Force it explicitly with:
# PAYMENTS_TEST_MODE=true|false

# --- Flights (optional) -----------------------------------------------------
# Live flight search via Duffel; without it, the flights page offers the
# manual quote-request flow.
# DUFFEL_API_KEY=duffel_live_...

# --- Email (optional) -------------------------------------------------------
# Transactional email via Resend (booking confirmations etc.).
# RESEND_API_KEY=re_...
