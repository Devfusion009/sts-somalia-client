# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — unanchored (was /node_modules): npm workspaces can leave a
# per-package node_modules nested under apps/*/ or packages/*/ for anything
# it can't hoist to the root, not just the root one.
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js — unanchored (was /.next//out/): apps/web's build output now
# lives at apps/web/.next, not the repo root.
.next/
out/

# production
/build

# apps/api's compiled output (tsc -p tsconfig.build.json)
apps/api/dist/

# packages/shared-types's compiled output (tsc) — apps/api and apps/web
# both consume it via package.json main/types, so it must be built before
# either app builds; see apps/api's "build" script.
packages/shared-types/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# supabase
supabase/.branches
supabase/.temp
supabase/.env

# vercel
.vercel

# repowise — local codebase-intelligence cache (db/lance/pickle state, regenerated)
/.repowise

# local business docs — not app code
/docs

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Local dev credentials — plaintext passwords for the local Supabase stack.
# Never committed: these are convenience notes for a machine-local database,
# and a leaked admin password in git history is not something you can take back.
*CREDENTIALS.local.md
*CREDENTIALS.local.txt
*.credentials.local

# credentials
.secrets/
