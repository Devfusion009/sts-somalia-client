# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# supabase
supabase/.branches
supabase/.temp
supabase/.env

# vercel
.vercel

# local business docs — not app code
/docs

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Local dev credentials — plaintext passwords for the local Supabase stack.
# Never committed: these are convenience notes for a machine-local database,
# and a leaked admin password in git history is not something you can take back.
*CREDENTIALS.local.md
*.credentials.local
