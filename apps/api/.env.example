# apps/api — backend env. Business-data credentials live only here now;
# apps/web keeps only the anon/publishable key (auth stays direct to Supabase).

PORT=4000
WEB_ORIGIN=http://localhost:3000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# redis://127.0.0.1:6379 locally (docker-compose's published port);
# the ElastiCache endpoint once deployed. Unset = degrades to "no cache", not broken.
REDIS_URL=
