# apps/api — backend env. Business-data credentials live only here now;
# apps/web keeps only the anon/publishable key (auth stays direct to Supabase).

PORT=4000
# Comma-separated: the public site plus every portal origin that calls tRPC from the browser.
WEB_ORIGIN=http://localhost:3000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# redis://127.0.0.1:6379 locally (docker-compose's published port);
# the ElastiCache endpoint once deployed. Unset = degrades to "no cache", not broken.
REDIS_URL=

# Server-only transactional email. Copy to apps/api/.env.local, which is
# loaded by the API entry point and local Docker Compose. Passwords belong
# only in ignored runtime env files or encrypted deployment secrets.
EMAIL_PROVIDER=
EMAIL_FROM=Scout Travel Solution <no-reply@scoutsts.com>
EMAIL_REPLY_TO=support@scoutsts.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@scoutsts.com
SMTP_PASS=
