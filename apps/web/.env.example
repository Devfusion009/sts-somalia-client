# ============================================================================
# STS Somalia — environment configuration
#
# The backend is plug-and-play: every optional integration below lights up
# automatically as soon as its keys are present (see src/lib/integrations.ts).
# With no optional keys set, the app still runs fully — payments fall back to
# manual methods (+ a built-in simulator outside production), and flight
# search shows the quote-request flow.
# ============================================================================

# --- Supabase (required) ----------------------------------------------------
# Local: run `supabase start`, then `supabase status` to see these values.
# Hosted: copy from the Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# Server-only. Bypasses RLS entirely — never expose to the client/browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Direct Postgres connection (migrations, scripts). Local default shown.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- apps/api (modular-monolith backend, phase 0+) --------------------------
# Business-data calls go here now; auth still talks to Supabase directly above.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Site URL used for auth redirects and payment return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Redis (optional — caches expensive reads; app runs fine without it) ---
# Cache-aside via src/lib/redis.ts: a Redis failure or REDIS_URL left unset
# falls back to querying the real source directly, just slower — never a
# hard dependency. Local: `docker compose up redis` (docker-compose.yml),
# or point this at any Redis instance. Not needed to run `npm run dev`
# unless you want to actually exercise the cache paths locally.
# REDIS_URL=redis://127.0.0.1:6379

# --- Portal subdomains (optional — Phase 2 of docs/B2B-PORTAL-SEPARATION-BUILD-PROMPT.md) ---
# Leave unset (default) and the admin/agent portals stay reachable at the
# Phase 1 paths /admin and /agent on this same host — nothing below changes
# behavior. Set this to turn on real subdomain separation instead: the admin
# console becomes reachable ONLY at admin.<value>, the agent portal ONLY at
# agent.<value>, and the plain /admin, /agent paths 404 on the main host —
# not just hidden, actually unreachable. See src/lib/subdomain.ts and
# src/proxy.ts.
#
# Production: your real registrable domain, with a wildcard DNS record
# (*.stssomalia.com) pointing at this deployment — a real infra step with
# your domain registrar/Vercel, not something set from code.
# NEXT_PUBLIC_APP_HOST=stssomalia.com
#
# Local dev: two options, both verified working end-to-end (routing,
# blocking, AND cross-subdomain login session) —
#
# Option A — *.localhost (zero setup, minor caveat): resolves to loopback
# on most systems with no /etc/hosts changes. Portal routing/blocking works
# fully. One real caveat found while verifying this: Chromium silently
# drops a real Set-Cookie response header for Domain=localhost from a
# subdomain (a single-label-host quirk, not a bug in this app) — so staying
# logged in when moving between admin./agent./root can be flaky in this
# mode specifically. Fine for checking the routing/blocking itself.
# NEXT_PUBLIC_APP_HOST=localhost:3000
#
# Option B — a fake multi-label domain via /etc/hosts (Recommended for
# testing full login flows, incl. staying signed in across subdomains):
#   echo "127.0.0.1 stssomalia.test admin.stssomalia.test agent.stssomalia.test" | sudo tee -a /etc/hosts
# .test is IANA-reserved for exactly this (RFC 6761) — never a real domain.
# NEXT_PUBLIC_APP_HOST=stssomalia.test:3000

# --- Admin-managed third-party integrations (required for /admin/integrations) --
# Encrypts flight/hotel/visa provider API keys (Duffel, Hotelbeds, Zylalabs)
# that admins save via /admin/integrations before storing them in the
# database — the column only ever holds ciphertext. Any long random string;
# generate one with `openssl rand -base64 32`.
INTEGRATIONS_ENCRYPTION_KEY=

# --- Payments (all optional — add keys to enable a gateway) -----------------
# These drive BOTH customer checkout and agency wallet top-ups
# (/agent/finance/top-up): a gateway whose keys are present appears in both
# places, one whose keys are absent appears in neither. Agencies can always
# fund a wallet offline (bank transfer / EVC Plus / cash at an office,
# confirmed by an admin), so no key here is required to operate.
#
# Card payments via Stripe Checkout:
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # endpoint: /api/payments/stripe/webhook

# Sifalo Pay: Somali mobile money (EVC Plus, ZAAD, Sahal, eDahab, Premier
# Wallet) and Visa/Mastercard behind one hosted checkout. Also configurable
# under Admin > Integrations > Payments. The webhook is registered per payment
# from API_PUBLIC_URL (must be https), so no dashboard setup is needed.
# SIFALO_API_USER=...
# SIFALO_API_KEY=...
# SIFALO_GATEWAY_URL=https://api.sifalopay.com/gateway/   # staging: see developer.sifalopay.com/docs/sandbox
# SIFALO_CHECKOUT_URL=https://pay.sifalo.com/checkout/
# API_PUBLIC_URL=https://api.example.com   # read by apps/api

# Somali mobile money via WaafiPay (EVC Plus / ZAAD / Sahal):
# WAAFI_MERCHANT_UID=M0000000
# WAAFI_API_USER_ID=1000000
# WAAFI_API_KEY=API-...
# WAAFI_API_URL=https://api.waafipay.net/asm   # optional override

# eDahab (Dahabshiil) invoices:
# EDAHAB_API_KEY=...
# EDAHAB_AGENT_CODE=...
# EDAHAB_API_URL=https://edahab.net/api/api/issueinvoice   # optional override

# Bank-transfer target — shown to customers at checkout and to agencies on
# the wallet top-up page:
# BANK_TRANSFER_BANK_NAME=Premier Bank
# BANK_TRANSFER_ACCOUNT_NAME=Scout Travel Solution LTD
# BANK_TRANSFER_ACCOUNT_NUMBER=020160002200

# Payment simulator: defaults to ON outside production so the whole checkout
# UX is demoable with zero keys. Force it explicitly with:
# PAYMENTS_TEST_MODE=true|false

# --- Flights (optional) -----------------------------------------------------
# Live flight search via Duffel; without it, the flights page offers the
# manual quote-request flow.
# DUFFEL_API_KEY=duffel_live_...

# --- Email (optional) -------------------------------------------------------
# Transactional email via Resend (booking confirmations, application status).
# Provisioned via Vercel Marketplace (`vercel integration add resend/resend-email`)
# — accept the marketplace terms in the browser first, then `vercel env pull`.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=STS Somalia <notifications@yourdomain.example>

# --- Admin support (optional) -----------------------------------------------
# Where the Admin Console's "Report a problem" button emails to (account menu →
# Help & support). Unset hides the button.
# SUPPORT_EMAIL=tech-support@yourdomain.example

# --- WhatsApp send (optional, distinct from the click-to-chat number above) -
# Outbound WhatsApp via Twilio's WhatsApp API — sends application status
# messages. Not available via Vercel Marketplace; requires a Twilio account
# AND Meta Business verification of the WhatsApp sender number (separate,
# manual process on Meta's side — budget a few days). Placeholder until then:
# code is fully wired, just inert without these three.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_FROM=+1415...   # the Twilio/Meta-approved WhatsApp sender number

# --- City/location search (on by default, free, no key required) -----------
# Powers real city autocomplete on the partner application forms via a
# server-side proxy (/api/places/autocomplete) — provider-swappable so a
# future developer can change it without touching call sites (see
# src/lib/provider-runtime/location-search.ts).
#
# Default provider: Photon (https://photon.komoot.io), komoot's free public
# geocoding API over OpenStreetMap data. No signup, no key, works out of the
# box. Point PHOTON_API_URL at a self-hosted Photon instance later if the
# public one's rate limit ever becomes a problem:
# PHOTON_API_URL=https://photon.komoot.io/api
#
# Switch to Google Places Autocomplete (New) instead — more polished results,
# but needs a Google Cloud project with billing enabled:
# LOCATION_SEARCH_PROVIDER=google
# GOOGLE_MAPS_API_KEY=AIza...

# --- Public holidays on the admin Booking Calendar (on by default, free, no key required) ---
# Shows holiday pills on /admin/calendar alongside real bookings — merges
# TWO free, keyless sources (see src/lib/provider-runtime/holidays.ts),
# since neither alone covers what this business needs: Nager.Date only has
# 4 fixed civil holidays for Somalia and zero Islamic-calendar coverage
# (Saudi Arabia/UAE aren't even in its country list), while the Islamic
# holidays that actually matter for an Umrah business — Eid al-Fitr, Eid
# al-Adha, Mawlid, Ashura, start of Ramadan — come from Aladhan's Hijri
# calendar conversion. Both provider-swappable without touching call sites.
# No admin UI for either: free and keyless, so unlike Duffel/Hotelbeds/
# Zylalabs there's no secret to store in the Integrations page (see its
# "Calendar" section for a plain status note instead).
#
# NOTE: Islamic holiday dates are astronomically calculated and can differ
# by ±1 day from the date locally announced by moon sighting.
#
# Civil holidays — Nager.Date (https://date.nager.at). No signup, no key.
# Point HOLIDAYS_API_URL elsewhere later if a different source is ever
# needed:
# HOLIDAYS_API_URL=https://date.nager.at/api/v3
#
# ISO 3166-1 alpha-2 country code for which civil holidays to show.
# Defaults to Somalia (STS's home market):
# HOLIDAYS_COUNTRY_CODE=SO
#
# Islamic holidays — Aladhan (https://api.aladhan.com). No signup, no key:
# ISLAMIC_HOLIDAYS_API_URL=https://api.aladhan.com/v1

# --- Admin calendar event reminders (optional but recommended in production) ---
# Vercel Cron (see vercel.json) hits /api/cron/admin-event-reminders every 5
# minutes to fire "N minutes before" reminders for admin-authored calendar
# events (src/app/admin/(portal)/calendar/) into the existing notifications
# table. Reminders ALSO fire opportunistically on every admin page load
# (src/app/admin/(portal)/layout.tsx), so this works immediately in local
# dev without any cron running — CRON_SECRET only matters once deployed.
#
# When set, Vercel automatically sends it as `Authorization: Bearer
# <value>` on cron invocations — the route rejects any other caller. Leave
# unset locally; generate a random value before deploying so the cron
# endpoint isn't callable by anyone who finds the URL:
# CRON_SECRET=

# --- WhatsApp support (optional) --------------------------------------------
# Click-to-chat number for the floating button and support links. Digits only,
# country code included. Defaults to the published STS support line.
# NEXT_PUBLIC_WHATSAPP_NUMBER=252611444420

# --- Demo login (hosted only — do not set locally) --------------------------
# Renders a "Try demo <role> account" button on /login, /agent/login,
# /admin/login, and /manager/login that signs straight into a fixed demo
# account (created by migration 20260903000008) with no typing. Set to
# "true" ONLY in .github/workflows/deploy.yml's hosted web deploy — never in
# a local .env.local, so local dev never shows these buttons. The demo
# accounts themselves exist in every environment (they're a migration); this
# flag controls only whether the one-click button is rendered.
#
# The demo admin account (demo.admin@stssomalia.com) has real
# is_platform_admin = true — full platform admin access, gated only by the
# fixed password in modules/demo/config.ts. Remove that button (and ideally
# deactivate the account) before this environment is shown to real
# customers or handles real bookings.
# DEMO_LOGIN_ENABLED=true

# --- Two-factor authentication ----------------------------------------------
# Uses Supabase's own TOTP MFA (auth.mfa.*), not a custom implementation.
# Already enabled for local dev in supabase/config.toml ([auth.mfa.totp]
# enroll_enabled/verify_enabled = true) — verified working with zero billing
# gate on the local CLI stack. On the HOSTED project, enable the equivalent
# toggle in the Supabase dashboard under Authentication → MFA before this
# will work in production (the "Pro plan" note some CLI versions ship in
# config.toml describes the hosted dashboard's self-serve toggle, not a
# restriction on TOTP MFA itself — confirm current behavior on your plan).
