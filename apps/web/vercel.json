{
  "git": {
    "deploymentEnabled": {
      "*": false,
      "feat/reference-ui-vercel": true
    }
  },
  "buildCommand": "npm run vercel-build",
  "env": {
    "STS_WORKER_SCHEDULER": "external",
    "DEPLOYMENT_ENV": "preview",
    "CUSTOMER_GOOGLE_LOGIN_ENABLED": "false"
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/design-preview"
    }
  ]
}
