# syntax=docker/dockerfile:1
# Build context is the REPO ROOT — same workspace reasoning as Dockerfile.web.

FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/shared-types/package.json packages/shared-types/package.json
RUN npm ci
# See Dockerfile.web's identical line — guarantees this COPY source exists
# regardless of npm's hoisting decision (apps/api currently keeps a nested
# node_modules for one non-hoistable dep; that could change).
RUN mkdir -p apps/api/node_modules

FROM node:22-alpine AS dev
WORKDIR /app
ENV NODE_ENV=development
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/shared-types ./packages/shared-types
EXPOSE 4000
CMD ["npm", "run", "start:dev", "-w", "api"]

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY package.json package-lock.json ./
COPY packages/shared-types ./packages/shared-types
COPY apps/api ./apps/api
RUN npm run build -w api

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 node-api \
  && adduser --system --uid 1001 api

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder --chown=api:node-api /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=api:node-api /app/packages/shared-types ./packages/shared-types

USER api
EXPOSE 4000
# All Supabase/Redis credentials arrive at container start via env_file,
# same secret-handling split as Dockerfile.web — none are build ARGs here,
# apps/api never bakes anything into a browser bundle.
CMD ["node", "apps/api/dist/main.js"]
