# Copy values into the GitHub "production" environment (secrets and vars).
# The deploy workflow writes the server's .env from them; nothing here is
# committed with real values.

# Proxy: Caddyfile.ip until a domain exists, then Caddyfile.domain.
CADDYFILE=Caddyfile.ip
SITE_DOMAIN=
ACME_EMAIL=

REDIS_PASSWORD=

NEXT_PUBLIC_SITE_URL=http://102.214.168.182
NEXT_PUBLIC_API_URL=http://102.214.168.182
WEB_ORIGIN=http://102.214.168.182

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
INTEGRATIONS_ENCRYPTION_KEY=
CRON_SECRET=

# Email: leave EMAIL_PROVIDER empty until a provider is connected (emails are
# logged, not sent). See apps/web/.env.example for the full description.
EMAIL_PROVIDER=
EMAIL_FROM=STS Somalia <no-reply@scoutsts.com>
EMAIL_REPLY_TO=info@scoutsts.com
RESEND_API_KEY=
