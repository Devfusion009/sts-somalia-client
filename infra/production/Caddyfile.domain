# Domain set: automatic HTTPS per host. Each host needs a DNS A record to the
# server and ports 80/443 open for the HTTP-01 challenge.
{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	@api path /trpc /trpc/* /payments/* /health/*
	handle @api {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}
}

admin.{$SITE_DOMAIN}, agent.{$SITE_DOMAIN}, manager.{$SITE_DOMAIN}, partner.{$SITE_DOMAIN}, affiliate.{$SITE_DOMAIN}, venue.{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

api.{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:4000
}
